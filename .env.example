
# pgwatch sink connection (PostgreSQL or TimescaleDB where pgwatch writes metrics)
SINK_CONN=postgres://pgwatch:pgwatch@localhost:5432/pgwatch

# The monitored PostgreSQL instance (for schema context like table sizes, queries)
DB_CONN=postgres://myuser:mypassword@localhost:5432/mydb

# Which pgwatch instance to scope to (run: SELECT DISTINCT sys_id FROM metrics.pgwatch2_pgwatch2)
SYS_ID=your-sys-id-here

# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# Model name
LLM_MODEL=gpt-4o-mini

# Your API key
LLM_API_KEY=sk-...

# Lookback window: "5m", "1h", or "24h"
WINDOW=5m